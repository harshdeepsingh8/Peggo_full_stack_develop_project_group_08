{
  "name": "peggo",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "start:frontend": "npm run dev --workspace=@peggo/frontend",
    "start:backend": "npm start --workspace=@peggo/backend",
    "dev": "concurrently \"npm:start:frontend\" \"npm:start:backend\""
  },
  "dependencies": {
    "dotenv": "*"
  },
  "devDependencies": {
    "concurrently": "*",
    "typescript": "~6.0.2"
  }
}